# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key...

# Định danh thiết bị (phải khớp device_code trong bảng devices)
DEVICE_CODE=DOOR_01
DEVICE_NAME=Main Door Pi

# Tuỳ chọn
# DEVICE_IP=192.168.1.10
# ROOM_UUID=<uuid của phòng trong bảng rooms, nếu có>

# DRY_RUN=1: chỉ in payload ra console, KHÔNG gửi lên Supabase (dùng để test trên PC)
DRY_RUN=0
