# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key...

# Dinh danh thiet bi (phai khop device_code trong bang devices - WEB seed, vd DOOR_101..DOOR_302)
# Dong device do web tao (kem room_id/door_id); Pi chi doc id + room_id tu bang devices.
DEVICE_CODE=DOOR_101
DEVICE_NAME=Raspberry Pi Door Device

# Tuy chon
# DEVICE_IP=192.168.1.10

# DRY_RUN=1: chi in payload ra console, KHONG gui len Supabase (dung de test tren PC)
DRY_RUN=0